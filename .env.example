# ==============================================================
# .env.example — Project Friday | Template Environment Variables
# ==============================================================
# CARA PAKAI:
#   cp .env.example .env
#   (lalu edit .env dengan nilai asli Anda)
#
# File .env TIDAK akan masuk ke GitHub (ada di .gitignore)
# ==============================================================

# Kamera — index device USB webcam (mis. eMeet C960), biasanya 0
# Jika tidak yakin index yang benar, jalankan:
#   python -c "from modules.kamera import daftar_kamera_tersedia; daftar_kamera_tersedia()"
CAMERA_INDEX=0

# Claude (Anthropic) API Key → https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenWeatherMap API Key → https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key_here

# NewsAPI Key → https://newsapi.org
NEWS_API_KEY=your_newsapi_key_here

# Nama pengguna (dipakai Friday untuk menyapa)
USER_NAME=NamaMu

# Kota untuk info cuaca (format: NamaKota,KODENEGARA)
WEATHER_CITY=Jakarta,ID
